{% doc %}
  Inline SVG icons used by the Gift Guide sections.

  Inlined (instead of an <img>) so the icons inherit `currentColor` and can be
  animated with CSS. Kept in one snippet to avoid repeating the markup.

  @param {string} name - One of: arrow, plus, close, menu.
  @param {string} [class] - Extra class added to the <svg>.

  @example
  {% render 'gift-icon', name: 'arrow', class: 'gift-btn__arrow' %}
{% enddoc %}

{%- liquid
  assign svg_class = class | default: ''
-%}

{%- case name -%}
  {%- when 'arrow' -%}
    <svg class="{{ svg_class }}" width="38" height="10" viewBox="0 0 38 10" fill="none" aria-hidden="true" focusable="false">
      <path d="M0 5h35.5M31 1l4.5 4-4.5 4" stroke="currentColor" stroke-width="1.4" fill="none"/>
    </svg>
  {%- when 'plus' -%}
    <svg class="{{ svg_class }}" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
      <path d="M6 0v12M0 6h12" stroke="currentColor" stroke-width="1.6"/>
    </svg>
  {%- when 'close' -%}
    <svg class="{{ svg_class }}" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
      <path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.4"/>
    </svg>
  {%- when 'menu' -%}
    <svg class="{{ svg_class }}" width="22" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true" focusable="false">
      <path d="M0 1h22M0 7h22M0 13h22" stroke="currentColor" stroke-width="1.6"/>
    </svg>
{%- endcase -%}
