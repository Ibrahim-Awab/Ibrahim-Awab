{%- comment -%}
  ---------------------------------------------------------------------------
  Gift grid
  ---------------------------------------------------------------------------
  Custom section built from scratch for the Gift Guide page. It shows a
  heading and six product tiles (one per block, products picked in the theme
  customizer). Each tile has a "+" hotspot that opens the quick-add popup.

  The popup is rendered once per section and filled by assets/gift-grid.js
  from the JSON payload printed next to each tile, so no extra request is
  needed and the variant inputs always match the picked product.

  Bundle rule: adding a variant whose options contain the trigger values
  (default "Black" and "Medium") also adds the bundled product to the cart.
{%- endcomment -%}

{{ 'gift-guide.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-grid.js' | asset_url }}" type="module"></script>

{%- liquid
  # The bundled product falls back to the "Soft Winter Jacket" handle when the
  # merchant has not picked one in the customizer.
  assign bundle_product = section.settings.bundle_product
  if bundle_product == blank
    assign bundle_product = all_products['soft-winter-jacket']
  endif
  assign bundle_variant = bundle_product.selected_or_first_available_variant
-%}

<div
  class="gift-grid"
  style="--gift-grid-columns: {{ section.settings.columns }};"
  data-gift-grid
>
  <div class="gift-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="gift-grid__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ul class="gift-grid__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign image = block.settings.image | default: product.featured_image
        -%}
        <li
          class="gift-grid__item"
          style="--gift-hotspot-x: {{ block.settings.hotspot_x }}%; --gift-hotspot-y: {{ block.settings.hotspot_y }}%;"
          data-gift-item
          {{ block.shopify_attributes }}
        >
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 900
              | image_tag:
                class: 'gift-grid__image',
                widths: '300,450,600,900',
                sizes: '(max-width: 749px) 50vw, 33vw',
                loading: 'lazy',
                alt: product.title
            }}
          {%- else -%}
            <div class="gift-grid__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
          {%- endif -%}

          {%- if product != blank -%}
            <button
              class="gift-grid__hotspot"
              type="button"
              aria-haspopup="dialog"
              aria-label="{{ section.settings.hotspot_label }}: {{ product.title | escape }}"
              data-gift-open
            >
              {%- render 'gift-icon', name: 'plus' -%}
            </button>

            {%- comment -%} Product data consumed by assets/gift-grid.js. {%- endcomment -%}
            <script type="application/json" data-gift-product>
              {%- render 'gift-product-data', product: product -%}
            </script>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- comment -%} Quick-add popup: one per section, reused by every tile. {%- endcomment -%}
  <dialog
    class="gift-popup"
    aria-label="{{ section.settings.hotspot_label }}"
    data-gift-popup
    data-bundle-product="{{ bundle_product.id }}"
    data-bundle-variant="{{ bundle_variant.id }}"
    data-bundle-options="{{ section.settings.bundle_options | escape }}"
    data-text-add-to-cart="{{ section.settings.add_to_cart_label | escape }}"
    data-text-sold-out="{{ section.settings.sold_out_label | escape }}"
    data-text-added="{{ section.settings.added_label | escape }}"
    data-text-select-options="{{ section.settings.select_options_label | escape }}"
    data-text-error="{{ section.settings.error_label | escape }}"
    data-text-placeholder="{{ section.settings.option_placeholder | escape }}"
  >
    <button class="gift-popup__close" type="button" aria-label="{{ section.settings.close_label }}" data-gift-close>
      {%- render 'gift-icon', name: 'close' -%}
    </button>

    <div class="gift-popup__summary">
      <img class="gift-popup__image" src="" alt="" width="108" height="132" data-gift-image>
      <div class="gift-popup__info">
        <p class="gift-popup__title" data-gift-title></p>
        <p class="gift-popup__price" data-gift-price></p>
        <p class="gift-popup__description" data-gift-description></p>
      </div>
    </div>

    {%- comment -%} Option inputs are built from the product's own options. {%- endcomment -%}
    <div class="gift-popup__options" data-gift-options></div>

    <p class="gift-popup__status" role="status" aria-live="polite" data-gift-status></p>

    <button class="gift-btn gift-popup__submit" type="button" data-gift-add>
      <span data-gift-add-label>{{ section.settings.add_to_cart_label }}</span>
      {%- render 'gift-icon', name: 'arrow', class: 'gift-btn__arrow' -%}
    </button>
  </dialog>
</div>

{% schema %}
{
  "name": "Gift grid",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "Mobile always shows two columns."
    },
    {
      "type": "header",
      "content": "Automatic bundle"
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bundled product",
      "info": "Added automatically when the option values below are selected. Defaults to the \"soft-winter-jacket\" product."
    },
    {
      "type": "text",
      "id": "bundle_options",
      "label": "Trigger option values",
      "default": "Black, Medium",
      "info": "Comma separated. The bundled product is added when the selected variant has all of these values."
    },
    {
      "type": "header",
      "content": "Popup"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart button",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "option_placeholder",
      "label": "Dropdown placeholder",
      "default": "Choose your [option]",
      "info": "[option] is replaced by the option name, for example \"size\"."
    },
    {
      "type": "text",
      "id": "select_options_label",
      "label": "Incomplete selection message",
      "default": "Please select all options."
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added to cart message",
      "default": "Added to cart."
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "error_label",
      "label": "Error message",
      "default": "Something went wrong. Please try again."
    },
    {
      "type": "text",
      "id": "hotspot_label",
      "label": "Hotspot label",
      "default": "Quick add",
      "info": "Used by screen readers."
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close label",
      "default": "Close"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. The product's featured image is used when empty."
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Hotspot horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Hotspot vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
