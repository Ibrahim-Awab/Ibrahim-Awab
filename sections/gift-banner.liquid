{%- comment -%}
  ---------------------------------------------------------------------------
  Gift banner
  ---------------------------------------------------------------------------
  Custom section built from scratch for the Gift Guide page. Three rows:

    1. Top bar   - logo, message and the yellow "Choose gift" button
    2. Hero      - full-bleed image with the heading, description and button
    3. Strip     - full width announcement line

  Every text in the design is a section setting, so the whole banner is
  editable from the theme customizer. Styles live in assets/gift-guide.css.
{%- endcomment -%}

{{ 'gift-guide.css' | asset_url | stylesheet_tag }}

<div
  class="gift-banner"
  style="--gift-hero-height: {{ section.settings.hero_height }}px; --gift-accent: {{ section.settings.top_button_color }};"
>
  {%- if section.settings.show_top_bar -%}
    <div class="gift-banner__bar">
      {%- comment -%} Logo: an uploaded image when present, otherwise the store name as text. {%- endcomment -%}
      <a class="gift-banner__logo" href="{{ routes.root_url }}">
        {%- if section.settings.logo_image != blank -%}
          {{
            section.settings.logo_image
            | image_url: width: 400
            | image_tag: class: 'gift-banner__logo-image', widths: '200,400', alt: section.settings.logo_text
          }}
        {%- else -%}
          {{ section.settings.logo_text }}
        {%- endif -%}
      </a>

      {%- if section.settings.top_message != blank -%}
        <p class="gift-banner__message">{{ section.settings.top_message }}</p>
      {%- endif -%}

      {%- if section.settings.top_button_label != blank -%}
        <a class="gift-btn gift-btn--yellow" href="{{ section.settings.top_button_link | default: '#' }}">
          <span>{{ section.settings.top_button_label }}</span>
          {%- render 'gift-icon', name: 'arrow', class: 'gift-btn__arrow' -%}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="gift-banner__hero">
    {%- if section.settings.hero_image != blank -%}
      {{
        section.settings.hero_image
        | image_url: width: 2400
        | image_tag:
          class: 'gift-banner__media',
          widths: '600,900,1200,1600,2000,2400',
          sizes: '100vw',
          fetchpriority: 'high',
          alt: section.settings.heading
      }}
    {%- else -%}
      <div class="gift-banner__media gift-banner__media--placeholder">
        {{- 'lifestyle-1' | placeholder_svg_tag -}}
      </div>
    {%- endif -%}

    <div class="gift-banner__text">
      {%- if section.settings.heading != blank -%}
        <h1 class="gift-banner__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="gift-banner__description">
          {{- section.settings.description | escape | newline_to_br -}}
        </p>
      {%- endif -%}
    </div>

    {%- if section.settings.hero_button_label != blank -%}
      <a class="gift-btn" href="{{ section.settings.hero_button_link | default: '#' }}">
        <span>{{ section.settings.hero_button_label }}</span>
        {%- render 'gift-icon', name: 'arrow', class: 'gift-btn__arrow' -%}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.strip_text != blank -%}
    <p class="gift-banner__strip">{{ section.settings.strip_text }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Gift banner",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "checkbox",
      "id": "show_top_bar",
      "label": "Show top bar",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Optional. The logo text below is used when no image is set."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "Tisso Vison"
    },
    {
      "type": "text",
      "id": "top_message",
      "label": "Message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "top_button_label",
      "label": "Button label",
      "default": "Choose gift"
    },
    {
      "type": "url",
      "id": "top_button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "top_button_color",
      "label": "Button color",
      "default": "#f8f36b"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Height on desktop",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Bottom strip"
    },
    {
      "type": "text",
      "id": "strip_text",
      "label": "Text",
      "default": "Sustainable, ethically made clothes in sizes XXS to 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift banner"
    }
  ]
}
{% endschema %}
